// ─────────────────────────────────────────────────────────────
export default function Guide() {
  const [activeTab, setActiveTab] = useState("stripe");
  const [openIdx, setOpenIdx]     = useState(0);

  const tab = TABS.find(t => t.id === activeTab);

  const steps =
    activeTab === "stripe"   ? STRIPE_STEPS  :
    activeTab === "jazzcash" ? JAZZCASH_STEPS :
    activeTab === "live"     ? LIVE_STEPS     : null;

  return (
    <div style={{
      minHeight: "100vh",
      background: "#070b14",
      fontFamily: "'Segoe UI', system-ui, sans-serif",
      color: "#e2e8f0",
    }}>
      {/* TOP HEADER */}
      <div style={{
        background: "linear-gradient(135deg,#0f172a,#111827)",
        borderBottom: "1px solid #1e293b",
        padding: "24px 20px 0",
        position: "sticky", top: 0, zIndex: 50,
      }}>
        <div style={{ maxWidth: 820, margin: "0 auto" }}>
          <div style={{ fontSize: 11, color: "#475569", letterSpacing: 2, marginBottom: 6 }}>
            PAYMENT GATEWAY SETUP GUIDE — ASIM RAZA
          </div>
          <div style={{ fontSize: 20, fontWeight: 800, color: "#f1f5f9", marginBottom: 20 }}>
            Connect Stripe · JazzCash · Go Live · PayPal vs Stripe
          </div>
          {/* Tabs */}
          <div style={{ display: "flex", gap: 4, overflowX: "auto" }}>
            {TABS.map(t => (
              <button key={t.id} onClick={() => { setActiveTab(t.id); setOpenIdx(0); }} style={{
                padding: "10px 18px",
                background: activeTab === t.id ? t.color : "transparent",
                border: `1px solid ${activeTab === t.id ? t.color : "#1e293b"}`,
                borderBottom: activeTab === t.id ? `1px solid ${t.color}` : "1px solid #1e293b",
                borderRadius: "8px 8px 0 0",
                color: activeTab === t.id ? "#fff" : "#64748b",
                fontWeight: 700, fontSize: 13, cursor: "pointer",
                whiteSpace: "nowrap", transition: "all 0.15s",
              }}>
                {t.label}
              </button>
            ))}
          </div>
        </div>
      </div>

      {/* BODY */}
      <div style={{ maxWidth: 820, margin: "0 auto", padding: "28px 16px 60px" }}>

        {/* ── STRIPE / JAZZCASH / LIVE ─────────────────────────── */}
        {steps && steps.map((step, i) => {
          const isOpen = openIdx === i;
          return (
            <div key={i} style={{
              marginBottom: 10,
              borderRadius: 14,
              border: `1px solid ${isOpen ? step.color + "60" : "#1a2233"}`,
              background: isOpen ? "#0b1120" : "#080e1a",
              overflow: "hidden",
              transition: "all 0.2s",
            }}>
              {/* Header row */}
              <div onClick={() => setOpenIdx(isOpen ? -1 : i)} style={{
                padding: "16px 20px", cursor: "pointer",
                display: "flex", alignItems: "center", gap: 14,
                background: isOpen ? `linear-gradient(135deg,${step.color}15,transparent)` : "transparent",
                userSelect: "none",
              }}>
                <div style={{
                  width: 38, height: 38, borderRadius: "50%",
                  background: isOpen ? step.color : "#1e293b",
                  display: "flex", alignItems: "center", justifyContent: "center",
                  fontSize: isOpen ? 18 : 14, fontWeight: 800,
                  color: isOpen ? "#fff" : "#64748b", flexShrink: 0,
                  transition: "all 0.2s",
                }}>
                  {isOpen ? step.emoji : step.n}
                </div>
                <div style={{ flex: 1 }}>
                  <div style={{ fontSize: 15, fontWeight: 700, color: isOpen ? "#f1f5f9" : "#94a3b8" }}>
                    Step {step.n} — {step.title}
                  </div>
                  {step.badge && (
                    <span style={{
                      display: "inline-block", marginTop: 4,
                      background: step.color + "25", color: step.color,
                      fontSize: 11, fontWeight: 700, padding: "2px 10px",
                      borderRadius: 20,
                    }}>{step.badge}</span>
                  )}
                </div>
                <span style={{ color: "#334155", fontSize: 20, transform: isOpen ? "rotate(180deg)" : "none", transition: "transform 0.2s" }}>⌄</span>
              </div>

              {isOpen && (
                <div style={{ padding: "0 20px 22px" }}>
                  {/* Body text */}
                  <div style={{
                    background: "#060c18", border: "1px solid #1e293b",
                    borderRadius: 10, padding: "16px 18px", marginBottom: 12,
                    fontSize: 13, color: "#94a3b8", lineHeight: 1.9,
                    whiteSpace: "pre-line",
                  }}>
                    {step.body}
                  </div>

                  {/* Single command */}
                  {step.command && !step.commands && (
                    <div style={{
                      background: "#020813", border: "1px solid #1e3a5f",
                      borderRadius: 10, padding: "12px 16px", marginBottom: 12,
                      display: "flex", alignItems: "center", gap: 12,
                    }}>
                      <span style={{ color: "#10b981", fontSize: 14 }}>$</span>
                      <code style={{ fontSize: 13, color: "#38bdf8", fontFamily: "monospace", flex: 1 }}>
                        {step.command}
                      </code>
                      <button onClick={() => navigator.clipboard?.writeText(step.command)} style={{
                        background: "#0f172a", border: "1px solid #1e3a5f",
                        color: "#475569", borderRadius: 6, padding: "3px 10px",
                        cursor: "pointer", fontSize: 11,
                      }}>copy</button>
                    </div>
                  )}

                  {/* Multiple commands */}
                  {step.commands && step.commands.map((c, ci) => (
                    <div key={ci} style={{ marginBottom: 8 }}>
                      <div style={{ fontSize: 11, color: "#475569", marginBottom: 4, paddingLeft: 4 }}>{c.label}</div>
                      <div style={{
                        background: "#020813", border: "1px solid #1e3a5f",
                        borderRadius: 10, padding: "10px 16px",
                        display: "flex", alignItems: "center", gap: 12,
                      }}>
                        <span style={{ color: "#10b981", fontSize: 13 }}>$</span>
                        <code style={{ fontSize: 12, color: "#38bdf8", fontFamily: "monospace", flex: 1 }}>{c.cmd}</code>
                        <button onClick={() => navigator.clipboard?.writeText(c.cmd)} style={{
                          background: "#0f172a", border: "1px solid #1e3a5f",
                          color: "#475569", borderRadius: 6, padding: "2px 8px",
                          cursor: "pointer", fontSize: 10,
                        }}>copy</button>
                      </div>
                    </div>
                  ))}

                  {/* Tip */}
                  {step.tip && (
                    <div style={{
                      background: "#0f172a", border: "1px solid #1e3a8f",
                      borderRadius: 10, padding: "10px 14px", marginBottom: 8,
                      display: "flex", gap: 10,
                    }}>
                      <span style={{ fontSize: 16, flexShrink: 0 }}>💡</span>
                      <span style={{ fontSize: 12, color: "#93c5fd", lineHeight: 1.7 }}>{step.tip}</span>
                    </div>
                  )}

                  {/* Warning */}
                  {step.warning && (
                    <div style={{
                      background: "#1a0f00", border: "1px solid #78350f",
                      borderRadius: 10, padding: "10px 14px", marginBottom: 8,
                      display: "flex", gap: 10,
                    }}>
                      <span style={{ fontSize: 16, flexShrink: 0 }}>⚠️</span>
                      <span style={{ fontSize: 12, color: "#fcd34d", lineHeight: 1.7 }}>{step.warning}</span>
                    </div>
                  )}

                  {/* Link */}
                  {step.link && (
                    <a href={step.link.url} target="_blank" rel="noopener noreferrer" style={{
                      display: "inline-block", marginTop: 4,
                      color: step.color, fontSize: 13, fontWeight: 700,
                      textDecoration: "none", borderBottom: `1px solid ${step.color}50`,
                    }}>
                      {step.link.text} ↗
                    </a>
                  )}

                  {/* Next button */}
                  {i < steps.length - 1 && (
                    <button onClick={() => setOpenIdx(i + 1)} style={{
                      marginTop: 16, width: "100%", padding: "11px",
                      background: `linear-gradient(135deg,${step.color},${step.color}bb)`,
                      border: "none", borderRadius: 10, color: "#fff",
                      fontWeight: 700, fontSize: 13, cursor: "pointer",
                    }}>
                      ✓ Got it — Next Step →
                    </button>
                  )}
                  {i === steps.length - 1 && (
                    <div style={{
                      marginTop: 16, textAlign: "center", padding: "14px",
                      background: step.color + "20", border: `1px solid ${step.color}40`,
                      borderRadius: 10, color: step.color, fontWeight: 700, fontSize: 14,
                    }}>
                      🎉 All steps complete for this section!
                    </div>
                  )}
                </div>
              )}
            </div>
          );
        })}

        {/* ── PAYPAL TAB ────────────────────────────────────────── */}
        {activeTab === "paypal" && (
          <div>
            {/* Verdict */}
            <div style={{
              background: "linear-gradient(135deg,#022c22,#031a12)",
              border: "1px solid #065f46", borderRadius: 14, padding: "22px 24px", marginBottom: 20,
              display: "flex", alignItems: "flex-start", gap: 16,
            }}>
              <span style={{ fontSize: 36 }}>✅</span>
              <div>
                <div style={{ fontSize: 17, fontWeight: 800, color: "#10b981", marginBottom: 6 }}>
                  Short Answer: YES — PayPal works perfectly with n8n
                </div>
                <div style={{ fontSize: 13, color: "#6ee7b7", lineHeight: 1.7 }}>
                  {PAYPAL_DATA.verdict}
                </div>
              </div>
            </div>

            {/* Comparison Table */}
            <div style={{ marginBottom: 24 }}>
              <div style={{ fontSize: 15, fontWeight: 700, color: "#f1f5f9", marginBottom: 12 }}>
                📊 Stripe vs PayPal — Side by Side
              </div>
              <div style={{ background: "#080e1a", border: "1px solid #1e293b", borderRadius: 14, overflow: "hidden" }}>
                <table style={{ width: "100%", borderCollapse: "collapse", fontSize: 13 }}>
                  <thead>
                    <tr style={{ background: "#0f172a" }}>
                      <th style={{ padding: "12px 16px", textAlign: "left", color: "#64748b", fontSize: 11, letterSpacing: 1 }}>FEATURE</th>
                      <th style={{ padding: "12px 16px", textAlign: "center", color: "#6366f1", fontSize: 12, fontWeight: 800 }}>🌍 STRIPE</th>
                      <th style={{ padding: "12px 16px", textAlign: "center", color: "#0ea5e9", fontSize: 12, fontWeight: 800 }}>💙 PAYPAL</th>
                    </tr>
                  </thead>
                  <tbody>
                    {PAYPAL_DATA.comparison.map((row, i) => (
                      <tr key={i} style={{ borderTop: "1px solid #1e293b", background: i % 2 === 0 ? "#06080f" : "#080e1a" }}>
                        <td style={{ padding: "11px 16px", color: "#94a3b8" }}>{row.feature}</td>
                        <td style={{ padding: "11px 16px", textAlign: "center", color: "#a5b4fc" }}>{row.stripe}</td>
                        <td style={{ padding: "11px 16px", textAlign: "center", color: "#7dd3fc" }}>{row.paypal}</td>
                      </tr>
                    ))}
                  </tbody>
                </table>
              </div>
            </div>

            {/* PayPal setup steps */}
            <div style={{ fontSize: 15, fontWeight: 700, color: "#f1f5f9", marginBottom: 12 }}>
              🔧 How to Connect PayPal in n8n (5 Steps)
            </div>
            {PAYPAL_DATA.paypalSteps.map((s, i) => (
              <div key={i} style={{
                marginBottom: 10, background: "#080e1a",
                border: "1px solid #1e293b", borderRadius: 12, padding: "16px 18px",
                display: "flex", gap: 14,
              }}>
                <div style={{
                  width: 32, height: 32, borderRadius: "50%", flexShrink: 0,
                  background: "linear-gradient(135deg,#0284c7,#0ea5e9)",
                  display: "flex", alignItems: "center", justifyContent: "center",
                  fontSize: 13, fontWeight: 800, color: "#fff",
                }}>
                  {s.n}
                </div>
                <div>
                  <div style={{ fontSize: 14, fontWeight: 700, color: "#e2e8f0", marginBottom: 6 }}>{s.title}</div>
                  <div style={{ fontSize: 13, color: "#94a3b8", lineHeight: 1.8, whiteSpace: "pre-line" }}>{s.body}</div>
                </div>
              </div>
            ))}

            {/* Final recommendation */}
            <div style={{
              background: "linear-gradient(135deg,#0c1a2e,#0a1628)",
              border: "1px solid #1e3a5f", borderRadius: 14, padding: "20px 22px", marginTop: 8,
              display: "flex", gap: 14, alignItems: "flex-start",
            }}>
              <span style={{ fontSize: 28 }}>🏆</span>
              <div>
                <div style={{ fontSize: 14, fontWeight: 800, color: "#38bdf8", marginBottom: 6 }}>
                  Final Recommendation for You (Pakistan-based)
                </div>
                <div style={{ fontSize: 13, color: "#7dd3fc", lineHeight: 1.8 }}>
                  {PAYPAL_DATA.recommendation}
                </div>
                <div style={{
                  marginTop: 12, display: "flex", gap: 8, flexWrap: "wrap",
                }}>
                  {["💙 PayPal — International customers","🇵🇰 JazzCash — Local Pakistan customers","🌍 Add Stripe later if needed"].map(t => (
                    <span key={t} style={{
                      background: "#0f2744", color: "#38bdf8",
                      fontSize: 12, fontWeight: 600, padding: "4px 12px",
                      borderRadius: 20, border: "1px solid #1e3a5f",
                    }}>{t}</span>
                  ))}
                </div>
              </div>
            </div>
          </div>
        )}
      </div>
    </div>
  );
}